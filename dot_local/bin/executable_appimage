#!/usr/bin/env bash
# appimage-install — install, update, list, and remove AppImages with desktop integration.
#
# What "install" does:
#   1. Copies (or moves) the AppImage to ~/Applications/<name>.AppImage and makes it executable
#   2. Pulls the app's own .desktop file and icon out of the AppImage
#   3. Creates a launcher in ~/.local/share/applications so it shows up in your app menu
#   4. Symlinks it into ~/.local/bin/<name> so you can run it from a terminal
# Re-running install with a newer AppImage of the same app updates it in place.

set -euo pipefail

APP_DIR="${APPIMAGE_DIR:-$HOME/Applications}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
DESKTOP_DIR="$DATA_DIR/applications"
ICON_DIR="$DATA_DIR/icons/appimage"
BIN_DIR="$HOME/.local/bin"
PREFIX="appimage-"   # launcher filename prefix, so we only ever touch our own entries

TMP=""
STAGE=""

msg()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

cleanup() {
  if [[ -n $TMP ]]; then rm -rf "$TMP"; fi
  if [[ -n $STAGE ]]; then rm -f "$STAGE"; fi
}
trap cleanup EXIT

usage() {
  cat <<EOF
Usage:
  $(basename "$0") <file.AppImage> [options]     Install (or update) an AppImage
  $(basename "$0") install <file.AppImage> [options]
  $(basename "$0") remove <name>                 Uninstall an app
  $(basename "$0") list                          Show installed AppImages

Install options:
  -n, --name NAME   Name to install under (default: taken from the app itself)
  -m, --move        Move the file instead of copying it

Install location: $APP_DIR  (override with APPIMAGE_DIR=/some/path)
EOF
}

slugify() {
  tr '[:upper:]' '[:lower:]' <<<"$1" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

check_fuse() {
  local ldc
  ldc="$(command -v ldconfig || echo /sbin/ldconfig)"
  [[ -x $ldc ]] || return 0
  if ! "$ldc" -p 2>/dev/null | grep -q 'libfuse\.so\.2'; then
    warn "libfuse2 not found. Many AppImages need it to run. Install it with:"
    warn "  Ubuntu/Debian: sudo apt install libfuse2   (Ubuntu 24.04+: libfuse2t64)"
    warn "  Fedora: sudo dnf install fuse-libs    Arch: sudo pacman -S fuse2"
  fi
}

# Extract a path from the AppImage into $TMP/squashfs-root (silently, best effort)
extract() {
  (cd "$TMP" && "$STAGE" --appimage-extract "$1" >/dev/null 2>&1) || true
}

cmd_install() {
  local src="" name="" move=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--name) name="${2:?--name needs a value}"; shift 2 ;;
      -m|--move) move=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) [[ -z $src ]] || die "only one AppImage at a time"; src="$1"; shift ;;
    esac
  done
  [[ -n $src ]] || die "no AppImage given (try --help)"
  [[ -f $src ]] || die "file not found: $src"
  src="$(realpath "$src")"

  if [[ $(dd if="$src" bs=1 skip=8 count=2 2>/dev/null) != "AI" ]]; then
    warn "$(basename "$src") doesn't look like a standard AppImage; trying anyway"
  fi

  mkdir -p "$APP_DIR" "$DESKTOP_DIR" "$ICON_DIR" "$BIN_DIR"

  # Stage inside APP_DIR so it's executable even if the source sits on a noexec mount
  STAGE="$APP_DIR/.staging-$$.AppImage"
  cp "$src" "$STAGE"
  chmod +x "$STAGE"
  TMP="$(mktemp -d)"

  # --- Pull metadata out of the AppImage -----------------------------------
  msg "Reading metadata from $(basename "$src")"
  local root="$TMP/squashfs-root"
  extract '*.desktop'
  extract '.DirIcon'

  local desktop_src=""
  if [[ -d $root ]]; then
    desktop_src="$(find "$root" -maxdepth 1 -name '*.desktop' -print -quit 2>/dev/null || true)"
  else
    warn "couldn't extract metadata (older type-1 AppImage?); creating a generic launcher"
  fi

  # .DirIcon is usually a symlink (sometimes a chain of them); follow and extract each target
  local link="$root/.DirIcon" icon_src="" i t rel
  for i in 1 2 3 4 5; do
    [[ -L $link ]] || break
    t="$(readlink "$link")"
    [[ $t == /* ]] && break
    rel="$(realpath -m --relative-to="$root" "$(dirname "$link")/$t")"
    extract "$rel"
    link="$root/$rel"
  done
  if [[ -f $link && ! -L $link ]]; then icon_src="$link"; fi

  # --- Work out the app name -------------------------------------------------
  local display=""
  if [[ -n $desktop_src ]]; then
    display="$(grep -m1 '^Name=' "$desktop_src" | cut -d= -f2- || true)"
  fi
  if [[ -z $name ]]; then
    if [[ -n $display ]]; then
      name="$display"
    else
      name="$(basename "$src")"
      name="${name%.*}"
      # drop version / arch suffixes like "-1.2.3-x86_64"
      name="$(sed -E 's/[-_ ]?v?[0-9]+(\.[0-9]+)+.*$//; s/[-_](x86_64|amd64|aarch64|arm64)$//' <<<"$name")"
    fi
  fi
  name="$(slugify "$name")"
  [[ -n $name ]] || die "couldn't determine a name; pass one with --name"
  display="${display:-$name}"

  local dest="$APP_DIR/$name.AppImage"
  if [[ -e $dest ]]; then msg "Updating existing install: $name"; else msg "Installing: $name"; fi

  mv -f "$STAGE" "$dest"
  STAGE=""

  # --- Icon --------------------------------------------------------------------
  local icon_dest=""
  if [[ -n $icon_src ]]; then
    local ext="${icon_src##*.}"
    if [[ ! $ext =~ ^(png|svg|xpm)$ ]]; then
      case "$(file -b --mime-type "$icon_src" 2>/dev/null || true)" in
        image/svg*) ext=svg ;;
        *) ext=png ;;
      esac
    fi
    rm -f "$ICON_DIR/$name".{png,svg,xpm}
    icon_dest="$ICON_DIR/$name.$ext"
    cp "$icon_src" "$icon_dest"
  else
    warn "no icon found inside the AppImage; using a generic one"
  fi

  # --- Launcher (.desktop file) -------------------------------------------------
  local entry="$DESKTOP_DIR/$PREFIX$name.desktop"
  if [[ -n $desktop_src ]] && grep -q '^Exec=' "$desktop_src"; then
    local -a sed_args=(
      -e "s|^Exec=[^ ]*|Exec=\"$dest\"|"   # point every Exec line at the installed file
      -e '/^TryExec=/d'
      -e '/^X-AppImage-/d'
    )
    if [[ -n $icon_dest ]]; then
      sed_args+=(-e "s|^Icon=.*|Icon=$icon_dest|")
    fi
    sed -E "${sed_args[@]}" "$desktop_src" > "$entry"
    if [[ -n $icon_dest ]] && ! grep -q '^Icon=' "$entry"; then
      sed -i "0,/^\[Desktop Entry\]/s||[Desktop Entry]\nIcon=$icon_dest|" "$entry"
    fi
  else
    cat > "$entry" <<EOF
[Desktop Entry]
Type=Application
Name=$display
Exec="$dest" %U
Icon=${icon_dest:-application-x-executable}
Terminal=false
Categories=Utility;
EOF
  fi
  chmod +x "$entry"
  command -v update-desktop-database >/dev/null && update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true

  # --- Terminal command ---------------------------------------------------------
  ln -sf "$dest" "$BIN_DIR/$name"
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) warn "$BIN_DIR isn't in your PATH, so the '$name' command won't work in a terminal yet" ;;
  esac

  if [[ $move -eq 1 && $src != "$dest" ]]; then rm -f "$src"; fi

  check_fuse
  msg "Done. Launch \"$display\" from your app menu, or run: $name"
}

cmd_remove() {
  local name
  name="$(slugify "${1:?usage: $(basename "$0") remove NAME  (see 'list' for names)}")"
  local dest="$APP_DIR/$name.AppImage" found=0 f

  for f in "$dest" "$DESKTOP_DIR/$PREFIX$name.desktop" "$ICON_DIR/$name".{png,svg,xpm}; do
    if [[ -e $f ]]; then rm -f "$f"; found=1; fi
  done
  if [[ -L $BIN_DIR/$name && $(readlink "$BIN_DIR/$name") == "$dest" ]]; then
    rm -f "$BIN_DIR/$name"
    found=1
  fi

  [[ $found -eq 1 ]] || die "nothing installed under the name '$name' (see 'list')"
  command -v update-desktop-database >/dev/null && update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
  msg "Removed $name (its settings in ~/.config, if any, were left alone)"
}

cmd_list() {
  shopt -s nullglob
  local files=("$APP_DIR"/*.AppImage) f
  if [[ ${#files[@]} -eq 0 ]]; then
    echo "No AppImages installed in $APP_DIR"
    return 0
  fi
  printf '%-30s %8s\n' NAME SIZE
  for f in "${files[@]}"; do
    printf '%-30s %8s\n' "$(basename "$f" .AppImage)" "$(du -h "$f" | cut -f1)"
  done
}

if [[ $EUID -eq 0 ]]; then
  warn "running as root installs into root's home folder, not yours; you probably don't want sudo here"
fi

case "${1:-}" in
  install|i)              shift; cmd_install "$@" ;;
  remove|uninstall|rm)    shift; cmd_remove "$@" ;;
  list|ls)                cmd_list ;;
  ""|-h|--help|help)      usage ;;
  *)
    if [[ -f $1 ]]; then cmd_install "$@"; else die "unknown command or file: $1 (try --help)"; fi
    ;;
esac
