{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*nuget.conf*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*npmrc*",
      "effect": "deny"
    }
  ]
}
