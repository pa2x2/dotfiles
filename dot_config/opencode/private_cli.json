{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "scroll": {
    "acceleration": true
  },
  "attention": {
    "enabled": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "image_preview": true,
    "permissions": "autoaccept"
  },
  "animations": false,
  "tabs": {
    "indicators": "status",
    "layout": "vertical"
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "terminal": {
    "title": true,
    "copy": "select"
  }
}
